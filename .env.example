# Local only. Copy to .env on the machine that runs Quickstart.
# Windows: D:\DEV\t3n-invoice-clerk\.env
# NEVER commit .env
#
# One claim, one key: https://go.terminal3.io/adk-community
# AGENT_KEY is the same value as T3N_API_KEY.

T3N_API_KEY=
AGENT_KEY=

# Optional. Earn-form DID only — not required to install, build, or run Quickstart.
# Not a runtime secret. authenticate() session DID always wins.
T3N_DID=did:t3n:53a6ae350a77d94b524b7ce345205a7d6afdf7c9

# Optional local/debug only. Never default. Never set in CI.
# If fetchTrustedManifest("testnet") throws "Trust manifest … is malformed"
# (SDK schema vs cluster), set this to 1 to pass { unsafe_trust_server: true }.
# T3N_UNSAFE_TRUST=1
