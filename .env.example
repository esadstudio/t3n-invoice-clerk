# Copy to .env locally if you want. Never commit .env.
# Official path is still: export the key in your shell (not written into a file).
# Claim once: https://go.terminal3.io/adk-community

# Tenant / developer key. Shown once on the claim page.
T3N_API_KEY=

# Same as T3N_API_KEY. One claim, one key — alias for agent CLI steps.
T3N_AGENT_KEY=

# Optional. Earn-form DID only — not required to install, build, or run quickstart.
# T3N_DID=did:t3n:53a6ae350a77d94b524b7ce345205a7d6afdf7c9
